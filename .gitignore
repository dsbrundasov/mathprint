# Ignore everything in the repository root by default.
/*

# Keep this file and the source/test/examples trees visible to Git.
!.gitignore
!AGENTS.md
!README.md
!pyproject.toml
!pyrightconfig.json
!/src/
!/src/**
!/typings/
!/typings/**
!/tests/
!/tests/**
!/examples/
!/examples/**
!/.vscode/
!/.vscode/**
!/docs/
!/docs/**

# Build and cache artifacts (these override the allowlist rules above).
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
