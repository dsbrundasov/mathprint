"""Type stubs for the ``mathprint`` macros.

``mpt`` is a macro: it is invoked as ``mpt[expression]``, which static type
checkers would otherwise report as subscripting a function.
"""

from typing import Any

class _Macro:
    def __getitem__(self, item: Any) -> Any: ...
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    # `mpt.latex()` enables LaTeX output for the calling file; `mpt.latex(False)`
    # disables it.
    latex: Any
    # `mpt.precision(n)` shows numbers in the calling file with `n` significant
    # digits; `mpt.precision(None)` restores the default.
    precision: Any

mpt: _Macro

# Set by the Jupyter extension during cell expansion.
_SOURCE_OVERRIDE: Any

# --- LaTeX output mode ----------------------------------------------------
# Scope keys of files that opted into LaTeX output (see `mpt.latex()`).
_LATEX_FILES: set[str]
_ANY_FILE: str

def _latex_key(filename: Any) -> str: ...
def _scope_key(globals_: Any) -> str: ...
def _latex_enabled(key: str) -> bool: ...
def _set_latex(enabled: bool = ...) -> str: ...
def _emit(key: str, text: str) -> None: ...
def _print_value(key: str, prefix: str, value: Any) -> Any: ...
def _pytexit_input(text: str) -> str: ...
def _display_latex(text: str) -> None: ...
def _fix_pytexit_constants() -> None: ...

# --- Display precision ----------------------------------------------------
# Scope keys of files that set `mpt.precision(n)`, mapped to `n`.
_PRECISION_FILES: dict[str, int]

def _set_precision(digits: int | None = ...) -> str: ...
def _precision_for(key: str) -> int | None: ...
def _format_number(value: Any, precision: int) -> str | None: ...
def _render(key: str, name: str, value: Any) -> str: ...
def _rendered_arg(key: str, name_node: Any) -> Any: ...

# --- Several expressions in one call --------------------------------------
# Collects `mpt[a, b, ...]` item values (evaluated left to right) into a tuple.
def _collect(*values: Any) -> tuple[Any, ...]: ...
def _expand_one(expr: Any, source: Any, key: str) -> Any: ...
